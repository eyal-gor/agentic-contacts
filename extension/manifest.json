{
  "manifest_version": 3,
  "name": "Agentic Contacts for LinkedIn",
  "version": "0.13.0",
  "description": "See who is already in your Agentic Contacts while you browse LinkedIn, add people in one click, and remember why you asked to connect.",
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://contacts.autobirds.com/*",
    "https://app.contacts.autobirds.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "icps.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Agentic Contacts",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "icon-32.png"
      ],
      "matches": [
        "https://www.linkedin.com/*"
      ]
    }
  ]
}
